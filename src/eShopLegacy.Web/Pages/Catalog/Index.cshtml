@page
@model eShopLegacy.Web.Pages.Catalog.IndexModel
@{
    ViewData["Title"] = "Catalog";
}

<h1>Product Catalog</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

<div class="row">
    @if (Model.Items != null && Model.Items.Any())
    {
        @foreach (var item in Model.Items)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text"><strong>Price:</strong> $@item.Price.ToString("F2")</p>
                        <p class="card-text"><small class="text-muted">Brand: @item.CatalogBrandName</small></p>
                        <p class="card-text"><small class="text-muted">Type: @item.CatalogTypeName</small></p>
                        <div class="btn-group" role="group">
                            <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="alert alert-info">No catalog items found.</p>
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @if (Model.PageIndex > 0)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.PageIndex - 1)" asp-route-pageSize="@Model.PageSize">Previous</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Previous</span>
                </li>
            }

            @for (int i = 0; i < Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pageIndex="@i" asp-route-pageSize="@Model.PageSize">@(i + 1)</a>
                </li>
            }

            @if (Model.PageIndex < Model.TotalPages - 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-page="Index" asp-route-pageIndex="@(Model.PageIndex + 1)" asp-route-pageSize="@Model.PageSize">Next</a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">Next</span>
                </li>
            }
        </ul>
    </nav>
}
